# Copy this file to backend/.env and fill in real values before running.
# NEVER commit backend/.env with real secrets.
# APP_ENV: development | production. Defaults to development.
APP_ENV=development
DATABASE_URL=sqlite:///./casa_aurelia.db
# DATABASE_URL=postgresql://user:password@localhost:5432/casa_aurelia

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@casaaurelia.it
# Minimum 8 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_PASSWORD=replace_with_a_secure_admin_password

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated allow-list of HTTP Host headers the app answers to
# (TrustedHostMiddleware). LEAVE EMPTY in development: localhost, 127.0.0.1 and
# the pytest client host are allowed automatically. PRODUCTION REQUIRES this to
# be set explicitly to the real production host(s) - the app refuses to boot
# without it (no "*" fallback).
# ALLOWED_HOSTS=

RESTAURANT_CAPACITY=40

# --- Email / SMTP (communication layer) ---
# Optional. When SMTP is NOT configured, the app still runs but the reservation
# confirmation email and contact-form owner notification are NOT sent. The API
# reports delivery honestly (email_sent=false); it never pretends an email was sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false            # implicit TLS (SMTPS) on connect
# SMTP_STARTTLS=true            # upgrade the connection via STARTTLS
# SMTP_FROM=no-reply@casaaurelia.it
# SMTP_FROM_NAME=Casa Aurelia
# Comma-separated owner notification recipients. Falls back to the seeded
# restaurant email when empty.
# NOTIFICATION_RECIPIENTS=owner@casaaurelia.it