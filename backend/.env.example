# Copy this file to backend/.env and fill in real values before running.
# NEVER commit backend/.env with real secrets.
# APP_ENV: development | production. Defaults to development.
APP_ENV=development
DATABASE_URL=sqlite:///./casa_aurelia.db
# DATABASE_URL=postgresql://user:password@localhost:5432/casa_aurelia

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@casaaurelia.it
# Minimum 8 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_PASSWORD=replace_with_a_secure_admin_password

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESTAURANT_CAPACITY=40