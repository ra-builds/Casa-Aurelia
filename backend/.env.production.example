# PRODUCTION environment template for Casa Aurelia.
#
# On the production host: copy this file to the process environment file that
# systemd loads (e.g. /opt/casaaurelia/backend/.env) and set the REAL values.
# NEVER commit a .env that contains real secrets.
#
# Reference: docs/Production_Deployment.md ("Environment (production)" section).

# development | production — REQUIRED. This is a first-class setting (Phase 8C).
APP_ENV=production

# ABSOLUTE path to the SQLite database (never a relative path in production).
# SQLite URL form for an absolute path: sqlite:////absolute/path/to/casa_aurelia.db
DATABASE_URL=sqlite:////opt/casaaurelia/backend/casa_aurelia.db

# ABSOLUTE directory for uploaded menu images.
# Generate on host: mkdir -p /opt/casaaurelia/backend/uploads/menu
UPLOAD_DIR=/opt/casaaurelia/backend/uploads

# Generate a strong 64-char secret (min 32 enforced):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_chars
ALGORITHM=HS256

# Admin login. ACCESS_TOKEN_EXPIRE_MINUTES=60 is the default; keep or tune.
ADMIN_EMAIL=admin@casaaurelia.it
# Generate (min 8 chars enforced):
#   python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_PASSWORD=replace_with_a_secure_admin_password
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed origins. In production the frontend is served from the
# SAME origin as the API through the reverse proxy, so CORS is not exercised;
# still set the canonical https origin.
CORS_ORIGINS=https://yourdomain.example

# Restaurant seating capacity guard (must match the seeded restaurant record).
RESTAURANT_CAPACITY=40
