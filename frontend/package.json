  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-seo.mjs && vite",
    "build": "node scripts/generate-seo.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node scripts/generate-seo.mjs && vite preview",
    "test": "node spec/getMinDate.test.mjs && node spec/reservationClosedDay.test.mjs && node spec/slotGroups.test.mjs && node spec/responsiveLayout.test.mjs && node spec/formatting.test.mjs && node spec/seo.test.mjs && node spec/performance.test.mjs && node spec/production.test.mjs && node spec/customization.test.mjs && node spec/template.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
